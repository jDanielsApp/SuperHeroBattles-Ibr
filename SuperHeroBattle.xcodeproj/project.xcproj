{
  "default-configuration": "Release",
  "configurations": [
    { "name": "Debug", "file": "Base.xcconfig" },
    { "name": "Release", "file": "Base.xcconfig" },
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "es",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/realm/realm-swift.git",
