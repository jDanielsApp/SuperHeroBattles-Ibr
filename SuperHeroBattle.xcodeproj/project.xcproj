      "kind": "remote",
      "repository": "https://github.com/airbnb/lottie-ios.git",
      "version": {
        "up-to-next-major-version": "4.6.1",
      },
    },
  ],
  "files": [
    { "path": "SuperHeroBattle/Config/Base.xcconfig" },
    { "path": "data/character_ids.json", "target-membership": [ "SuperHeroBattle/resources" ] },
    {
      "kind": "folder",
      "path": "SuperHeroBattle",
      "target-membership": [
        "SuperHeroBattle",
      ],
