            "Config/Secrets.xcconfig",
            "Resources/Info.plist",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "Tests/UnitTests", "target-membership": [ "SuperHeroBattleTests" ] },
    { "kind": "folder", "path": "Tests/UITests", "target-membership": [ "SuperHeroBattleUITests" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/SuperHeroBattle.app", "id": "A51C9C7F30ADF64100A944AA", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/SuperHeroBattleTests.xctest", "id": "A51C9C8C30ADF64200A944AA", "type": "wrapper.cfbundle", "index": false },
